# All optional locally. On Vercel, set these in Project → Settings → Environment Variables.

# Password for the portal (login page) and for the extension (Settings → Portal password).
# Leave empty locally for no login.
PORTAL_PASSWORD=

# Optional: separate password just for the extension. Defaults to PORTAL_PASSWORD.
INGEST_TOKEN=

# Gmail account that sends applications, and a Gmail app password (not your normal password):
# Google Account → Security → 2-Step Verification → App passwords
EMAIL_USER=
EMAIL_PASS=
# Sender name shown to HR (default: Aadarsh Jain)
MAIL_FROM_NAME=

# Database. Added automatically when you connect Upstash Redis in Vercel → Storage.
# Without these, posts are saved to data/*.json (fine locally, NOT on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
