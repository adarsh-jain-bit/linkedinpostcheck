{
  "manifest_version": 3,
  "name": "LinkedIn Post Checker",
  "version": "0.3.0",
  "description": "Capture LinkedIn posts from search results and send them to your portal.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Capture LinkedIn posts",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
